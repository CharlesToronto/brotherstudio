<button class="btn bg-white text-black dropdown-toggle px-3" style="min-width:inherit" type="button" data-bs-toggle="dropdown" data-bs-toggle="dropdown"><i class="fas fa-globe mr-2"></i><span class="m-0 p-0">FR</span></button>
<div class="dropdown-menu dropdown-menu-right p-0 skiptranslate"><a class="d-block h-auto p-3 m-0 w-100 text-left dropdown-item text-dark hidden" data-lang="fr" href="javascript:void(null)" onclick="googleTranslateWebsite('fr')">French</a><a class="d-block h-auto p-3 m-0 w-100 text-left dropdown-item text-dark" data-lang="en" href="javascript:void(null)" onclick="googleTranslateWebsite('en')">English</a></div>
</div></span><span style="display:none;">			<script type="text/javascript">
        const pageLanguage = 'fr';
        const availableLanguages = ["fr","en"];
        const browserLanguage = '';
        const manualTranslation = false;

        function updateLanguageDropdown(language) {
          $('.topmenuSocial.skiptranslate .dropdown-toggle span').text(language.toUpperCase());
          $('.topmenuSocial.skiptranslate .dropdown-menu a').removeClass('hidden');
          $(`.topmenuSocial.skiptranslate .dropdown-menu a[data-lang="${language}"]`).addClass('hidden');
        }

        function googleTranslateElementInit() {
          const includedLanguages = availableLanguages.filter((language) => language !== pageLanguage).join(',');

          new google.translate.TranslateElement({
            pageLanguage,
            includedLanguages,
            useCookie: true,
            autoDisplay: true,
            multilanguagePage: false,
            bodyStyle: 'font-family:Arial;'
          }, 'google_translate_element');

          onGoogleTranslate(({ newLanguage }) => {
            updateLanguageDropdown(newLanguage);
          });

          if (!manualTranslation) {
            autoTranslate(getGoogleTranslateLanguage() ?? browserLanguage);
          }
        }

        function autoTranslate(language) {
          if (document.getElementById(':1.container')) {
            googleTranslateWebsite(language);

            return;
          }

          setTimeout(() => autoTranslate(language), 100);
        }

        function googleTranslateWebsite(language) {
          $('html').removeClass('ko_ThemeMobileMenuOpen');

          // restore original site language
          if (language === pageLanguage) {
            const iframe = document.getElementById(':1.container');
            const restore = iframe.contentDocument.getElementById(':1.restore');

            restore.click();

            return;
          }

          // translate site
          const languageSelect = document.querySelector("#google_translate_element select");

          if (languageSelect) {
            languageSelect.value = language;
            languageSelect.dispatchEvent(new Event("change"));
          }
        }

        function getGoogleTranslateLanguage() {
          const cookies = document.cookie.split(';');
          const cookie = cookies.find(cookie => cookie.trim().startsWith('googtrans='));

          if (!cookie) {
            return undefined;
          }

          const value = cookie.split('=')[1].trim();
          const parts = value.split('/');

          return parts.length === 3 ? parts[2] : undefined;
        }

        function onGoogleTranslate(onTranslated) {
          const target = document.documentElement;
          const observer = new MutationObserver((mutations) => {
            const oldLanguage = mutations.at(0).oldValue.toLowerCase();
            const newLanguage = target.lang.toLowerCase();

            onTranslated({ oldLanguage, newLanguage });
          });

          observer.observe(document.documentElement, {
            attributes: true,
            attributeOldValue: true,
            attributeFilter: ['lang'],
          });
        }
			</script>

      <div id="google_translate_element" style="display:none"></div>
